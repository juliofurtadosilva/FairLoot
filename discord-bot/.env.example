# Discord Developer Portal (discord.com/developers/applications) — "Bot" tab
DISCORD_TOKEN=

# Same page, "General Information" tab — "Application ID"
DISCORD_CLIENT_ID=

# Optional: your Discord server's ID (right-click server icon > Copy Server ID, needs Developer Mode
# enabled in Discord settings). Set this while testing so /simc registers instantly on your server
# instead of waiting up to 1h for a global command. Remove/leave blank once you're happy with it.
DISCORD_GUILD_ID=

# Your FairLoot backend base URL (e.g. https://fairloot.onrender.com)
FAIRLOOT_API_URL=

# Global secret shared by THIS bot deployment and the FairLoot backend (Discord:BotSharedSecret in
# appsettings.json / the Discord__BotSharedSecret env var on the server) — NOT per-guild. Every WoW
# guild that invites this bot links itself by pasting its own Discord Server ID in FairLoot's Admin
# panel; this secret just proves the request came from this bot at all.
FAIRLOOT_BOT_SHARED_SECRET=
